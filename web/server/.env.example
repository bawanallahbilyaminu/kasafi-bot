# Copy to .env (never commit it)
PORT=3001
# Clerk: dashboard.clerk.com -> your app -> API keys
CLERK_PUBLISHABLE_KEY=pk_live_xxx
CLERK_SECRET_KEY=sk_live_xxx
# Kasafi engine (laptop or Colab), reached through a Cloudflare tunnel. Same key as ENGINE_API_KEY in the engine's .env
ENGINE_URL=https://xxxx.trycloudflare.com
ENGINE_API_KEY=a-long-random-string
# SQLite file for profiles and chat history
DB_PATH=./data/kasafi-web.sqlite
# Serve the built React app from here in production (npm run build in ../client)
CLIENT_DIST=../client/dist
