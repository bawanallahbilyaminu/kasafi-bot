# Copy this file to .env and fill in. Never share or commit .env.

# Hugging Face token (read). Accept the terms on both model pages first:
#   https://huggingface.co/NCAIR1/N-ATLaS   and   https://huggingface.co/NCAIR1/Hausa-ASR
HF_TOKEN=hf_xxx

# Telegram: create the bot with @BotFather, paste its token
TELEGRAM_BOT_TOKEN=123456:ABC-xyz

# WhatsApp via Twilio Sandbox (optional)
TWILIO_ACCOUNT_SID=ACxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxx
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# LLM backend: transformers (local GPU) | openai (Colab/vLLM backup) | none (testing)
LLM_BACKEND=transformers
LLM_4BIT=1
# For LLM_BACKEND=openai:
# OPENAI_BASE_URL=https://<your-tunnel>.trycloudflare.com/v1
# OPENAI_MODEL=NCAIR1/N-ATLaS

ASR_ENABLED=1

# Hausa voice-note replies (facebook/mms-tts-hau). VOICE_REPLY: voice (reply by voice when the user sent a
# voice note) | always | never. Users can also send /murya on Telegram to get every answer as voice.
TTS_ENABLED=1
VOICE_REPLY=voice
# Speaking rate of the voice (1.0 = model default, lower = slower and clearer)
TTS_RATE=0.9
# WhatsApp voice notes need this server's public https address (your cloudflared tunnel URL):
# PUBLIC_BASE_URL=https://xxxx.trycloudflare.com

# Any random string; used to hash user ids in the interaction log
LOG_SALT=put-a-long-random-string-here

# Ask new users for name + organisation before the first answer (1 = on)
REQUIRE_REGISTRATION=1
# Your Telegram id (send /myid to the bot), comma-separated for several admins: enables /stats /recent /bad
ADMIN_TELEGRAM_IDS=

# Web app (web/): shared secret for the engine's /api routes. Empty = web API off.
ENGINE_API_KEY=
